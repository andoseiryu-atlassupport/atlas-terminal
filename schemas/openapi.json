    "/v1/research": {
      "post": {
        "summary": "Get Research",
        "operationId": "get_research_v1_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "companies"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "identifier", "limit"]
                      },
                      "required": []
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "profile"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "identifier"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "statements"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": [
                          "dataset",
                          "allow_partial",
                          "count",
                          "identifier",
                          "metrics",
                          "period"
                        ]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "ratios"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": [
                          "dataset",
                          "allow_partial",
                          "count",
                          "identifier",
                          "period"
                        ]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "company_facts"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": [
                          "dataset",
                          "concept",
                          "identifier",
                          "limit",
                          "taxonomy",
                          "unit"
                        ]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "filings"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "form", "identifier", "limit"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "insider_transactions"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "accession", "identifier", "limit"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "institutional_holdings"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "accession", "identifier", "limit"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "ownership_filings"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "identifier", "limit"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "fund_filings"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "identifier", "limit"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "corporate_action_filings"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "identifier", "limit"]
                      },
                      "required": ["identifier"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "economics"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "limit", "series"]
                      },
                      "required": ["series"]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "treasury_yields"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "limit", "year"]
                      },
                      "required": []
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "federal_debt"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "limit"]
                      },
                      "required": []
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "policy_news"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": ["dataset", "limit"]
                      },
                      "required": []
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "dataset": {
                          "const": "compare"
                        }
                      },
                      "required": ["dataset"]
                    },
                    "then": {
                      "propertyNames": {
                        "enum": [
                          "dataset",
                          "allow_partial",
                          "identifiers",
                          "metrics",
                          "period"
                        ]
                      },
                      "required": ["identifiers"]
                    }
                  }
                ],
                "properties": {
                  "dataset": {
                    "type": "string",
                    "enum": [
                      "companies",
                      "profile",
                      "statements",
                      "ratios",
                      "company_facts",
                      "filings",
                      "insider_transactions",
                      "institutional_holdings",
                      "ownership_filings",
                      "fund_filings",
                      "corporate_action_filings",
                      "economics",
                      "treasury_yields",
                      "federal_debt",
                      "policy_news",
                      "compare"
                    ],
                    "title": "Dataset"
                  },
                  "identifier": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Identifier"
                  },
                  "identifiers": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "maxItems": 10,
                    "title": "Identifiers"
                  },
                  "metrics": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "maxItems": 40,
                    "title": "Metrics"
                  },
                  "period": {
                    "type": "string",
                    "enum": ["annual", "quarterly", "ytd"],
                    "title": "Period",
                    "default": "annual"
                  },
                  "count": {
                    "type": "integer",
                    "maximum": 20.0,
                    "minimum": 1.0,
                    "title": "Count",
                    "default": 3
                  },
                  "limit": {
                    "type": "integer",
                    "maximum": 500.0,
                    "minimum": 1.0,
                    "title": "Limit",
                    "default": 100
                  },
                  "allow_partial": {
                    "type": "boolean",
                    "title": "Allow Partial",
                    "default": false
                  },
                  "taxonomy": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
                    "title": "Taxonomy",
                    "default": "us-gaap"
                  },
                  "concept": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,199}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Concept"
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_/-]{0,49}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Unit"
                  },
                  "form": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9 /-]{0,29}$",
                    "title": "Form",
                    "default": "all"
                  },
                  "accession": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Accession"
                  },
                  "series": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_]{1,40}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Series"
                  },
                  "year": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 2100.0,
                        "minimum": 1990.0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Year"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": ["dataset"],
                "title": "ResearchQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Research V1 Research Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/resolve": {
      "get": {
        "summary": "Resolve Company",
        "operationId": "resolve_company_v1_companies_resolve_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/filings": {
      "get": {
        "summary": "List Filings",
        "operationId": "list_filings_v1_filings_get",
        "parameters": [
          {
            "name": "cik",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{10}$",
              "title": "Cik"
            }
          },
          {
            "name": "form",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "10-K",
              "title": "Form"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 3,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Filings V1 Filings Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quotes": {
      "post": {
        "summary": "Quote Financials",
        "operationId": "quote_financials_v1_quotes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "identifier": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "title": "Identifier"
                  },
                  "metrics": {
                    "items": {
                      "type": "string",
                      "enum": [
                        "revenue",
                        "net_income",
                        "assets",
                        "liabilities",
                        "operating_cash_flow"
                      ]
                    },
                    "type": "array",
                    "maxItems": 5,
                    "minItems": 1,
                    "title": "Metrics"
                  },
                  "period": {
                    "type": "string",
                    "const": "annual",
                    "title": "Period",
                    "default": "annual"
                  },
                  "count": {
                    "type": "integer",
                    "maximum": 20.0,
                    "minimum": 1.0,
                    "title": "Count",
                    "default": 3
                  },
                  "allow_partial": {
                    "type": "boolean",
                    "title": "Allow Partial",
                    "default": false
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": ["identifier", "metrics"],
                "title": "FinancialQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quotes/{quote_id}/status": {
      "get": {
        "summary": "Purchase Status",
        "operationId": "purchase_status_v1_quotes__quote_id__status_get",
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Quote Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Purchase Status V1 Quotes  Quote Id  Status Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quotes/{quote_id}/result": {
      "get": {
        "summary": "Purchase Result",
        "operationId": "purchase_result_v1_quotes__quote_id__result_get",
        "parameters": [
          {
            "name": "quote_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Quote Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseResult"
                }
              }
            }
          },
          "202": {
            "description": "Settlement unknown; do not sign again"
          },
          "402": {
            "description": "Official x402 challenge, or explicit mock challenge"
          },
          "401": {
            "description": "Recovery capability or matching proof required"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Company": {
        "properties": {
          "cik": {
            "type": "string",
            "pattern": "^[0-9]{10}$",
            "title": "Cik"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "tickers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tickers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["cik", "name", "tickers"],
        "title": "Company"
      },
      "Coverage": {
        "properties": {
          "requested_periods": {
            "type": "integer",
            "title": "Requested Periods"
          },
          "available_periods": {
            "type": "integer",
            "title": "Available Periods"
          },
          "requested_cells": {
            "type": "integer",
            "title": "Requested Cells"
          },
          "reported_cells": {
            "type": "integer",
            "title": "Reported Cells"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_periods",
          "available_periods",
          "requested_cells",
          "reported_cells"
        ],
        "title": "Coverage"
      },
      "Fact": {
        "properties": {
          "metric": {
            "type": "string",
            "enum": [
              "revenue",
              "net_income",
              "assets",
              "liabilities",
              "operating_cash_flow"
            ],
            "title": "Metric"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "status": {
            "type": "string",
            "enum": ["reported", "unavailable", "ambiguous"],
            "title": "Status"
          },
          "unit": {
            "type": "string",
            "const": "USD",
            "title": "Unit",
            "default": "USD"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Source"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["metric", "value", "status", "period", "reason", "source"],
        "title": "Fact"
      },
      "FinancialQuery": {
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Identifier"
          },
          "metrics": {
            "items": {
              "type": "string",
              "enum": [
                "revenue",
                "net_income",
                "assets",
                "liabilities",
                "operating_cash_flow"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Metrics"
          },
          "period": {
            "type": "string",
            "const": "annual",
            "title": "Period",
            "default": "annual"
          },
          "count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Count",
            "default": 3
          },
          "allow_partial": {
            "type": "boolean",
            "title": "Allow Partial",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["identifier", "metrics"],
        "title": "FinancialQuery"
      },
      "FinancialResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.1.0",
            "title": "Schema Version",
            "default": "0.1.0"
          },
          "kind": {
            "type": "string",
            "const": "financials",
            "title": "Kind",
            "default": "financials"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "query": {
            "$ref": "#/components/schemas/FinancialQuery"
          },
          "provider": {
            "type": "string",
            "enum": ["fixture", "sec"],
            "title": "Provider"
          },
          "selection_policy": {
            "type": "string",
            "const": "latest_primary_filing_per_fact_v1",
            "title": "Selection Policy",
            "default": "latest_primary_filing_per_fact_v1"
          },
          "period_ends": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Period Ends"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Facts"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "partial": {
            "type": "boolean",
            "title": "Partial"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array",
            "title": "Warnings"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "retrieved_at": {
            "type": "string",
            "title": "Retrieved At"
          },
          "is_synthetic": {
            "type": "boolean",
            "title": "Is Synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "company",
          "query",
          "provider",
          "period_ends",
          "facts",
          "coverage",
          "partial",
          "warnings",
          "limitations",
          "retrieved_at",
          "is_synthetic"
        ],
        "title": "FinancialResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
