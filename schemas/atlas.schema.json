{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas.invalid/atlas-0.1.schema.json",
  "title": "Atlas application contract \u2014 design specification, not x402 wire schema",
  "$defs": {
    "FinancialQuery": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "metrics": {
          "items": {
            "enum": [
              "revenue",
              "net_income",
              "assets",
              "liabilities",
              "operating_cash_flow"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "period": {
          "const": "annual",
          "default": "annual",
          "title": "Period",
          "type": "string"
        },
        "count": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "allow_partial": {
          "default": false,
          "title": "Allow Partial",
          "type": "boolean"
        }
      },
      "required": ["identifier", "metrics"],
      "title": "FinancialQuery",
      "type": "object"
    },
    "Company": {
      "additionalProperties": false,
      "properties": {
        "cik": {
          "pattern": "^[0-9]{10}$",
          "title": "Cik",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tickers": {
          "items": {
            "type": "string"
          },
          "title": "Tickers",
          "type": "array"
        }
      },
      "required": ["cik", "name", "tickers"],
      "title": "Company",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
          "title": "Accession",
          "type": "string"
        },
        "form": {
          "enum": ["10-K", "10-K/A"],
          "title": "Form",
          "type": "string"
        },
        "filed_on": {
          "title": "Filed On",
          "type": "string"
        },
        "accepted_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted At"
        },
        "taxonomy": {
          "const": "us-gaap",
          "default": "us-gaap",
          "title": "Taxonomy",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "raw_source_url": {
          "title": "Raw Source Url",
          "type": "string"
        },
        "json_pointer": {
          "title": "Json Pointer",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "accession",
        "form",
        "filed_on",
        "accepted_at",
        "tag",
        "source_url",
        "raw_source_url",
        "json_pointer",
        "raw_sha256",
        "retrieved_at"
      ],
      "title": "Source",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["duration", "instant"],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": ["kind", "start", "end"],
      "title": "Period",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "revenue",
            "net_income",
            "assets",
            "liabilities",
            "operating_cash_flow"
          ],
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "status": {
          "enum": ["reported", "unavailable", "ambiguous"],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "const": "USD",
          "default": "USD",
          "title": "Unit",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["metric", "value", "status", "period", "reason", "source"],
      "title": "Fact",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "requested_periods": {
          "title": "Requested Periods",
          "type": "integer"
        },
        "available_periods": {
          "title": "Available Periods",
          "type": "integer"
        },
        "requested_cells": {
          "title": "Requested Cells",
          "type": "integer"
        },
        "reported_cells": {
          "title": "Reported Cells",
          "type": "integer"
        }
      },
      "required": [
        "requested_periods",
        "available_periods",
        "requested_cells",
        "reported_cells"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": ["code", "message"],
      "title": "Warning",
      "type": "object"
    },
    "FinancialResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "financials",
          "default": "financials",
          "title": "Kind",
          "type": "string"
        },
        "company": {
          "$ref": "#/$defs/Company"
        },
        "query": {
          "$ref": "#/$defs/FinancialQuery"
        },
        "provider": {
          "enum": ["fixture", "sec"],
          "title": "Provider",
          "type": "string"
        },
        "selection_policy": {
          "const": "latest_primary_filing_per_fact_v1",
          "default": "latest_primary_filing_per_fact_v1",
          "title": "Selection Policy",
          "type": "string"
        },
        "period_ends": {
          "items": {
            "type": "string"
          },
          "title": "Period Ends",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "partial": {
          "title": "Partial",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "company",
        "query",
        "provider",
        "period_ends",
        "facts",
        "coverage",
        "partial",
        "warnings",
        "limitations",
        "retrieved_at",
        "is_synthetic"
      ],
      "title": "FinancialResult",
      "type": "object"
    },
    "Pricing": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["off", "mock", "testnet", "mainnet"],
          "title": "Mode",
          "type": "string"
        },
        "scheme": {
          "enum": ["none", "exact"],
          "title": "Scheme",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "pay_to": {
          "title": "Pay To",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "decimals": {
          "maximum": 18,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "amount_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Amount Atomic",
          "type": "string"
        },
        "display_amount": {
          "title": "Display Amount",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "scheme",
        "network",
        "asset",
        "pay_to",
        "symbol",
        "decimals",
        "amount_atomic",
        "display_amount"
      ],
      "title": "Pricing",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "quote_id": {
          "title": "Quote Id",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/FinancialQuery"
        },
        "company": {
          "$ref": "#/$defs/Company"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "period_ends": {
          "items": {
            "type": "string"
          },
          "title": "Period Ends",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "partial": {
          "title": "Partial",
          "type": "boolean"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/Missing"
          },
          "title": "Missing",
          "type": "array"
        },
        "pricing": {
          "$ref": "#/$defs/Pricing"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "resource_path": {
          "title": "Resource Path",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "quote_id",
        "query",
        "company",
        "snapshot_id",
        "result_sha256",
        "period_ends",
        "coverage",
        "partial",
        "missing",
        "pricing",
        "expires_at",
        "resource_path",
        "limitations",
        "is_synthetic"
      ],
      "title": "Quote",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "properties": {
        "quote_id": {
          "title": "Quote Id",
          "type": "string"
        },
        "mode": {
          "enum": ["off", "mock", "testnet", "mainnet"],
          "title": "Mode",
          "type": "string"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "status": {
          "enum": ["NOT_REQUIRED", "SETTLED"],
          "title": "Status",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "amount_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Amount Atomic",
          "type": "string"
        },
        "transaction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transaction"
        },
        "settled_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Settled At"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "retained_until": {
          "title": "Retained Until",
          "type": "string"
        }
      },
      "required": [
        "quote_id",
        "mode",
        "simulated",
        "status",
        "network",
        "asset",
        "amount_atomic",
        "transaction",
        "settled_at",
        "result_sha256",
        "retained_until"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "PurchaseResult": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/FinancialResult"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        }
      },
      "required": ["data", "receipt"],
      "title": "PurchaseResult",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorPayload"
        }
      },
      "required": ["error"],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "ReconcileRequest": {
      "additionalProperties": false,
      "properties": {
        "transaction": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transaction"
        }
      },
      "title": "ReconcileRequest",
      "type": "object"
    },
    "ReconciliationResult": {
      "additionalProperties": false,
      "properties": {
        "quote_id": {
          "title": "Quote Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "QUOTED",
            "EXPIRED",
            "SETTLED",
            "NOT_REQUIRED",
            "FAILED",
            "SETTLEMENT_UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "settled",
            "failed",
            "pending",
            "not_started",
            "not_required"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["quote_id", "state", "outcome", "reason", "checked_at"],
      "title": "ReconciliationResult",
      "type": "object"
    },
    "ErrorPayload": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "next_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        }
      },
      "required": ["code", "message", "retryable", "details", "request_id"],
      "title": "ErrorPayload",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "fix_query",
            "inspect_catalog",
            "resolve_company",
            "review_coverage",
            "review_requirements",
            "retry_read",
            "request_quote",
            "wait",
            "check_purchase_status",
            "contact_operator",
            "restart_query",
            "stop"
          ],
          "title": "Action",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "automatic": {
          "default": false,
          "title": "Automatic",
          "type": "boolean"
        }
      },
      "required": ["action"],
      "title": "NextAction",
      "type": "object"
    },
    "BudgetWindow": {
      "additionalProperties": false,
      "properties": {
        "limit_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Limit Atomic",
          "type": "string"
        },
        "spent_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Spent Atomic",
          "type": "string"
        },
        "reserved_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Reserved Atomic",
          "type": "string"
        },
        "remaining_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Remaining Atomic",
          "type": "string"
        }
      },
      "required": [
        "limit_atomic",
        "spent_atomic",
        "reserved_atomic",
        "remaining_atomic"
      ],
      "title": "BudgetWindow",
      "type": "object"
    },
    "BudgetStatus": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "local_wallet",
          "default": "local_wallet",
          "title": "Scope",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "enum": ["mock", "testnet"],
          "title": "Mode",
          "type": "string"
        },
        "network": {
          "title": "Network",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "decimals": {
          "const": 6,
          "default": 6,
          "title": "Decimals",
          "type": "integer"
        },
        "per_purchase_atomic": {
          "maxLength": 40,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Per Purchase Atomic",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/BudgetWindow"
        },
        "day": {
          "$ref": "#/$defs/BudgetWindow"
        },
        "utc_day": {
          "title": "Utc Day",
          "type": "string"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "mode",
        "network",
        "asset",
        "per_purchase_atomic",
        "session",
        "day",
        "utc_day",
        "checked_at"
      ],
      "title": "BudgetStatus",
      "type": "object"
    },
    "PurchasePreflight": {
      "additionalProperties": false,
      "description": "Advisory only: no reservation, wallet access or payment authorization.",
      "properties": {
        "scope": {
          "enum": ["order", "local_wallet"],
          "title": "Scope",
          "type": "string"
        },
        "advisory": {
          "const": true,
          "default": true,
          "title": "Advisory",
          "type": "boolean"
        },
        "quote_id": {
          "title": "Quote Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "QUOTED",
            "EXPIRED",
            "SETTLED",
            "NOT_REQUIRED",
            "FAILED",
            "SETTLEMENT_UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        },
        "decision": {
          "enum": ["ready", "recover", "wait", "blocked"],
          "title": "Decision",
          "type": "string"
        },
        "code": {
          "enum": [
            "READY",
            "PAYMENT_NOT_REQUIRED",
            "ALREADY_SETTLED",
            "RESULT_EXPIRED",
            "QUOTE_EXPIRED",
            "PAYMENT_FAILED",
            "SETTLEMENT_UNKNOWN",
            "PURCHASE_ALREADY_STARTED",
            "PAYMENTS_DISABLED",
            "POLICY_DENIED",
            "WALLET_NOT_CONFIGURED",
            "BUDGET_EXCEEDED"
          ],
          "title": "Code",
          "type": "string"
        },
        "pricing": {
          "$ref": "#/$defs/Pricing"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        },
        "retained_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retained Until"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetStatus"
