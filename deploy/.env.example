# Install privately as /etc/atlas-terminal/mcp.env with mode 0600, owned by root.
# Required for bearer mode: supply a private 32-256 character token.
# Leave unset for an explicitly generated anonymous deployment.
# ATLAS_MCP_AUTH_TOKEN=
# Required only for SEC data: an application name and your actual contact email.
# SEC_USER_AGENT=
# Optional exact browser origins, comma-separated; no wildcard.
# ATLAS_MCP_ALLOWED_ORIGINS=

# Optional free registered BEA national accounts key; never expose to tools/logs.
BEA_API_KEY=
