# Install privately as /etc/atlas-terminal/seller.env (root-owned, mode 0600).
# Incomplete configuration fails closed. This template does not activate real payments.
ATLAS_SELLER_PAYMENTS=off
ATLAS_PRICE_ATOMIC=10000
ATLAS_SELLER_MAX_SOURCE_AGE_SECONDS=172800
# Base mainnet USDC receiving PUBLIC address. Never store the receiving wallet's private key here.
ATLAS_PAY_TO=
# CDP facilitator credentials belong only in this private server file.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Trusted HTTPS Base mainnet RPC with finalized/EIP-1898/log/receipt support.
ATLAS_MAINNET_RPC_URL=
