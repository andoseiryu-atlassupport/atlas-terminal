{
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 120s
			idle 120s
		}
	}
}

__DOMAIN__ {
	request_body {
		max_size 16KB
	}
	# Caddy preserves Host. Do not enable access logging for this service.
	reverse_proxy 127.0.0.1:8001 {
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
