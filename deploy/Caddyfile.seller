{
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 120s
			idle 120s
		}
	}
}

__DOMAIN__ {
	request_body {
		max_size 16KB
	}
	# Preserve Host; omit access logs containing recovery/payment headers.
	# Only the isolated seller app is proxied. Never mount the free research app here.
	reverse_proxy 127.0.0.1:8002 {
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
