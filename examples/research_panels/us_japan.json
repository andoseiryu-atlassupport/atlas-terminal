        "dataflow": "IMF.DEMO,ATLAS_MACRO,1.0",
        "dimensions": {
          "FREQUENCY": "M",
          "COUNTRY": "USA",
          "INDICATOR": "CPI"
        }
      },
      "aggregation": "mean"
    },
    {
      "id": "jp_prices",
      "query": {
        "dataset": "international_economics",
        "source_id": "oecd",
        "dataflow": "OECD.DEMO,ATLAS_MACRO,1.0",
        "dimensions": {
          "FREQ": "M",
          "REF_AREA": "JPN",
          "MEASURE": "CPI"
        }
      },
      "aggregation": "mean"
    }
  ]
