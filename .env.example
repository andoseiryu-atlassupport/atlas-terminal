# Names only. Atlas reads process environment, not .env files automatically.
# No setting is needed for atlas demo or --provider fixture.
SEC_USER_AGENT=
# Optional BEA national accounts only; free registration at apps.bea.gov/api/signup/.
BEA_API_KEY=
# Optional Census economic indicators and FRED-distributed DOL claims; free API keys.
CENSUS_API_KEY=
FRED_API_KEY=
# Optional official Japanese filing metadata/numeric XBRL; free EDINET API v2 key.
EDINET_API_KEY=
# Optional international Yahoo market prices/actions/analytics, personal use only; default off.
ATLAS_ENABLE_YAHOO_FINANCE=0
ATLAS_STATE_DIR=
# Research-only Streamable HTTP service. HTTPS origin, without /mcp.
ATLAS_MCP_PUBLIC_ORIGIN=
# Private bearer token; omit only with explicit --allow-anonymous.
ATLAS_MCP_AUTH_TOKEN=
# Optional comma-separated exact allowed browser origins.
ATLAS_MCP_ALLOWED_ORIGINS=
# Explicit hosted origin, no path; HTTPS except loopback development.
ATLAS_HOSTED_ORIGIN=
ATLAS_POLICY_FILE=
ATLAS_SESSION_ID=default
# Public testnet payer address for read-only budget/preflight; never a private key.
# When configured, actual purchases require the local signer to match this address.
ATLAS_TESTNET_PAYER_ADDRESS=
# Server-only reference price; this is not a commercial price.
ATLAS_PRICE_ATOMIC=10000
ATLAS_PUBLIC_ORIGIN=
# Dedicated testnet settings. Never paste private values into a chat.
ATLAS_PAY_TO=
ATLAS_FACILITATOR_URL=
# Optional server-only, trusted Base Sepolia RPC for read-only reconciliation.
# Requires finalized blocks, EIP-1898 eth_call and authorization log queries.
ATLAS_TESTNET_RPC_URL=
ATLAS_TESTNET_PRIVATE_KEY=
ATLAS_TESTNET_NETWORK=eip155:84532
ATLAS_TESTNET_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Live smoke tests are excluded by default.
ATLAS_RUN_LIVE_SEC=0
ATLAS_RUN_LIVE_X402=0
